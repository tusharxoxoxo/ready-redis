APP_ENV=development
POSTGRES_USER=notify
POSTGRES_PASSWORD=secret
POSTGRES_DB=notifydb
DATABASE_URL=postgresql://notify:secret@postgres:5432/notifydb
# Local dev: redis://redis:6379/0
# Production (Upstash): rediss://default:<password>@nearby-cat-25697.upstash.io:6379
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local dev:  CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Optional real provider credentials (leave blank for mock mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=
