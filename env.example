POSTGRES_USER=notify
POSTGRES_PASSWORD=secret
POSTGRES_DB=notifydb
DATABASE_URL=postgresql://notify:secret@postgres:5432/notifydb
REDIS_URL=redis://redis:6379/0
SECRET_KEY=supersecretkey-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Optional: Real provider credentials ─────────────
# Leave blank = mock mode (logs delivery, no real sends)

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (Firebase FCM)
FCM_SERVER_KEY=
